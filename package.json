{
  "name": "dsh-skill-superpowers",
  "version": "1.1.1",
  "description": "Superpowers skills for the DeepSeek Harness (dsh): a full engineering methodology served through dsh's own filesystem skill provider, with an always-on bootstrap.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "artifacts.json",
    "skills",
    "references",
    "docs",
    "scripts",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "superpowers",
    "agent-skills",
    "claude-skills",
    "skills",
    "tdd",
    "brainstorming",
    "workflow",
    "subagents",
    "ai-coding-agent"
  ],
  "license": "MIT",
  "author": "minglo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minglo/dsh-skill-superpowers.git"
  },
  "homepage": "https://github.com/minglo/dsh-skill-superpowers#readme",
  "bugs": {
    "url": "https://github.com/minglo/dsh-skill-superpowers/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tests/test-plugin.mjs",
    "sync-skills": "node scripts/sync-skills.mjs",
    "check-upstream": "node scripts/check-upstream.mjs",
    "generate-artifacts": "node scripts/generate-artifacts.mjs",
    "check-artifacts": "node scripts/generate-artifacts.mjs --check",
    "verify": "node scripts/generate-artifacts.mjs --check && node tests/test-plugin.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "upstream": {
    "$comment": "The upstream project this package vendors, and the revision last vendored. The repository URL here is the single source the scripts read — nothing else hard-codes it.",
    "repository": "https://github.com/obra/superpowers",
    "tag": "v7.0.1",
    "commit": "2ce8aa15d05bd57213e6f746f953aafb7ded7a8b",
    "synced": "2026-10-22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.0.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.0.1-rc.1 <0.3.0-0"
  }
}
